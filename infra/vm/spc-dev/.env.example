# SPC DEVELOPMENT environment. Copy to `.env` and set real values. `.env` is gitignored.
#
# Uses the dev database (student_projects_dev) and the spc_dev_* roles, isolated from prod.

# App role (DML only) — used by the running backend.
DATABASE_URL=postgresql+asyncpg://spc_dev_app:CHANGE_ME@data-postgres:5432/student_projects_dev?ssl=disable
# Owner role (DDL) — used only by the migration runner.
DATABASE_MIGRATION_URL=postgresql+asyncpg://spc_dev_owner:CHANGE_ME@data-postgres:5432/student_projects_dev?ssl=disable

# Long random string (>=32 chars) — distinct from prod.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Public base URL of the dev SPA (used in outgoing email links).
FRONTEND_URL=https://swe.fm.tul.cz/dev/projects/

# Cookie names — dev-specific so they don't clash with prod on the shared host.
SESSION_COOKIE_NAME=session_dev
XSRF_COOKIE_NAME=XSRF-TOKEN-dev

# SMTP relay for OTP / notification emails.
SMTP_HOST=smtp.tul.cz
SMTP_PORT=587
SMTP_USERNAME=lukas.jezek@tul.cz
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=lukas.jezek@tul.cz

# OpenTelemetry export endpoint — empty until the observability stack lands (Step 5).
OTEL_EXPORTER_OTLP_ENDPOINT=
