# Superuser for the shared Postgres server. Copy to `.env` and set a REAL password.
# `.env` is gitignored — never commit real credentials.
#
# This role ONLY bootstraps the server (runs the provisioner) and takes backups; it owns
# no application data. The per-database owner/app roles live in provision.conf instead.

# These are the official postgres image variables (the entrypoint creates this superuser).
# NOTE: Postgres reserves the "pg_" prefix for internal roles — the superuser name must
# NOT start with "pg_".
POSTGRES_USER=spc_superadmin
POSTGRES_PASSWORD=change-me-superuser
# Keep application data out of the maintenance DB; app DBs are created by the provisioner.
POSTGRES_DB=postgres
