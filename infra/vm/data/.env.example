# Shared PostgreSQL configuration for the VM. Copy to `.env` and set REAL passwords.
# `.env` is gitignored — never commit real credentials.
#
# These names mirror database/.env.example so the reused database/init-db.sh works
# unchanged. The app stacks (spc/, spc-dev/) build their DATABASE_URL /
# DATABASE_MIGRATION_URL from these same values, pointing at host `data-postgres`.

# ── Admin role (DDL + DML) — used by Alembic migrations ───────────────────────
POSTGRES_ADMIN_USER=tul_psi_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_DB=student_projects

# ── Application role (DML only) — used by the running backend ──────────────────
POSTGRES_APP_USER=tul_psi_app
POSTGRES_APP_PASSWORD=change-me-app

# ── Extra databases to create on first start (comma-separated) ────────────────
# Each gets the same app-role grants as POSTGRES_DB. Add future apps' DBs here.
EXTRA_DATABASES=student_projects_dev
