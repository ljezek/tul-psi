# SPC PRODUCTION environment. Copy to `.env` and set real values. `.env` is gitignored.
#
# DSNs point at the shared Postgres container (`data-postgres`) on the `data` network.
# ?ssl=disable is required: the in-cluster Postgres speaks plaintext on a private network,
# and the backend otherwise forces TLS outside local/e2e.

# App role (DML only) — used by the running backend.
DATABASE_URL=postgresql+asyncpg://spc_prod_app:CHANGE_ME@data-postgres:5432/student_projects?ssl=disable
# Owner role (DDL) — used only by the migration runner.
DATABASE_MIGRATION_URL=postgresql+asyncpg://spc_prod_owner:CHANGE_ME@data-postgres:5432/student_projects?ssl=disable

# Long random string (>=32 chars) — signs the JWT session cookie.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Public base URL of the SPA (used in outgoing email links).
FRONTEND_URL=https://swe.fm.tul.cz/projects/

# Cookie names — prod keeps the defaults (dev overrides them to avoid clashing on the host).
SESSION_COOKIE_NAME=session
XSRF_COOKIE_NAME=XSRF-TOKEN

# SMTP relay for OTP / notification emails.
SMTP_HOST=smtp.tul.cz
SMTP_PORT=587
SMTP_USERNAME=lukas.jezek@tul.cz
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=lukas.jezek@tul.cz

# OpenTelemetry export endpoint — empty until the observability stack lands (Step 5).
OTEL_EXPORTER_OTLP_ENDPOINT=
